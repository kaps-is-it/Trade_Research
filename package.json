{
  "name": "runthispr-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "backend": "node --env-file-if-exists=.env server/index.mjs",
    "test:trading": "node --test server/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src && node --test server/*.test.mjs",
    "smoke:feeds": "node scripts/smoke-feeds.mjs",
    "smoke:nvidia": "node --env-file-if-exists=.env scripts/smoke-nvidia.mjs",
    "smoke:supabase": "node --env-file-if-exists=.env scripts/smoke-supabase.mjs",
    "format": "prettier --write src scripts vite.config.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
