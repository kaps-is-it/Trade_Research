# Backend: Node 24+ required. Local development binds to loopback only.
TRADING_HOST=127.0.0.1
TRADING_PORT=8787
TRADING_PUBLIC_MODE=false
TRADING_RATE_STATE_PATH=data/provider-rate-history.json
TRADING_DB_PATH=data/trading.sqlite
# Optional Supabase storage. With either value set, both are required.
# If absent, the worker uses SQLite. These must remain server-side.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
TRADING_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# For hosting, bind to 0.0.0.0, use Supabase or persistent disk and set a random token
# of at least 24 characters. Never prefix server secrets with VITE_.
# TRADING_ADMIN_TOKEN=
# TRADING_ALLOWED_ORIGINS=https://www.runthispr.com
# Frontend build only, if the worker is hosted separately:
# VITE_TRADING_API_URL=https://your-worker.example.com

# Connect any subset of providers. Exact model IDs are selected per run.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ENABLE_OLLAMA=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# NVIDIA NIM API key (integrate.api.nvidia.com/v1), server-side only. One key
# serves z-ai/glm-5.3, deepseek-ai/deepseek-v4.1-flash and
# nvidia/nemotron-3-ultra-550b-a55b.
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_MAX_TOKENS=32768
# NVIDIA_NIM_TIMEOUT_MS=300000

# GLM 5.3 only: low / high / max. High balances continuous checks and reasoning.
# Output allowance above stays independent. NVIDIA otherwise defaults to max.
# NVIDIA_GLM_REASONING_EFFORT=high
